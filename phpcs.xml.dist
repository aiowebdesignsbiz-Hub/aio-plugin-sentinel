<?xml version="1.0"?>
<ruleset name="AIO Sentinel">
	<description>Security-focused WordPress static analysis for AIO Sentinel.</description>
	<file>aio-sentinel.php</file>
  <file>includes</file>
  <file>mu-plugin</file>
  <file>uninstall.php</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <rule ref="WordPress.Security" />
</ruleset>
