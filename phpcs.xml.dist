<?xml version="1.0"?>
<ruleset name="AIO Malicious Extension Guard">
	<description>Security-focused WordPress static analysis for AIO Malicious Extension Guard.</description>
	<file>aio-malicious-extension-guard.php</file>
  <file>includes</file>
  <file>mu-plugin</file>
  <file>uninstall.php</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <rule ref="WordPress.Security" />
</ruleset>
